// Prisma schema. Models follow the conceptual model in
// PROJECT_BRIEF_TICKETING_PROJECT_TRACKER.md §11. SLA, comments and attachments are not
// modelled yet (open decisions in docs/requirements/OPEN_QUESTIONS.md).
// Change it only through reviewed migrations (README › Database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with ROLES in src/domain/access/roles.ts (a unit test enforces it).
enum Role {
  SUPERADMIN
  ADMIN
  SALES
  SOA
  PURCHASING
  FINANCE
  MANAGEMENT
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  // Stored lower-cased; the migration adds a CHECK constraint enforcing it.
  email        String   @unique
  passwordHash String   @map("password_hash")
  // One role per user (assumption A-1 in docs/requirements/RBAC.md).
  role         Role
  // Also sees what Management sees (read only), on top of the role above. Set by a superadmin; never for Admin, Superadmin or Management.
  alsoManagement Boolean @default(false) @map("also_management")
  isActive     Boolean  @default(true) @map("is_active")
  // True while somebody else chose this password (an account an administrator created or reset, and the first superadmin):
  // the person is sent to the password page and can reach nothing else until they have chosen their own (T-9).
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // The prefix of this person's request codes (RFQ-S-260001): one letter of the e-mail address, more if that letter is taken. Set once.
  codePrefix   String?  @unique @map("code_prefix")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[] @relation("SessionUser")
  impersonations    Session[] @relation("SessionImpersonator")
  deviceCredentials DeviceCredential[]
  audits            AuditEvent[]
  ownedProjects     Project[]              @relation("ProjectSalesOwner")
  requestsCreated   Request[]              @relation("RequestRequester")
  flowStopped       Request[]              @relation("RequestFlowStoppedBy")
  requestsDeleted   Request[]              @relation("RequestDeletedBy")
  statusChanges     RequestStatusHistory[]
  picAssignments    RequestPicAssignment[] @relation("AssignmentChangedBy")
  technicalProjects Project[]              @relation("ProjectTechnicalPic")
  purchasingProjects Project[]             @relation("ProjectPurchasingPic")
  deletedProjects   Project[]              @relation("ProjectDeletedBy")
  teamSettings      TeamSetting[]          @relation("TeamSettingUpdatedBy")
  appSettings       AppSetting[]           @relation("AppSettingUpdatedBy")
  rolePermissionChanges RolePermissionOverride[] @relation("RolePermissionUpdatedBy")
  projectChanges    ProjectChange[]
  progressChanges   ProjectProgressHistory[] @relation("ProgressChangedBy")
  projectActions    ProjectAction[]
  notifications     Notification[]
  salesTargets      SalesTarget[]

  quotationsPrepared  Quotation[] @relation("QuotationPreparedBy")
  quotationsSubmitted Quotation[] @relation("QuotationSubmittedBy")
  quotationApprovals  QuotationApproval[] @relation("QuotationApprovalDecidedBy")
  quotationsReturned  Quotation[] @relation("QuotationReturnedBy")
  quotationsChosen    Quotation[] @relation("QuotationChosenBy")
  quotationsCancelled Quotation[] @relation("QuotationCancelledBy")
  @@map("users")
}

// Server-side login sessions. Only the SHA-256 of the cookie token is stored.
// Failed sign-ins, counted per e-mail and per client address, so password guessing is slowed down (T-7, src/domain/access/login-throttle.ts).
// Not a history: the row is updated on every failure and deleted on a successful sign-in. An address is stored as a SHA-256.
model LoginAttempt {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // "email" or "ip" (a database check keeps it to these two).
  scope         String
  key           String
  failures      Int       @default(0)
  firstFailedAt DateTime  @default(now()) @map("first_failed_at") @db.Timestamptz(3)
  lastFailedAt  DateTime  @default(now()) @map("last_failed_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([lastFailedAt])
  @@map("login_attempts")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when a superadmin opened this session to see the application as the user above (read only, one hour, never renewed).
  impersonatorId String? @map("impersonator_id") @db.Uuid

  user         User  @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  impersonator User? @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// An account remembered on one browser, so Switch Account needs no password again (never for ADMIN or SUPERADMIN). The browser holds a
// random token and this row's id in an HttpOnly cookie; only a salted SHA-256 of the token is stored.
model DeviceCredential {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  salt       String
  tokenHash  String    @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("device_credentials")
}

// Append-only: the migration installs triggers that reject UPDATE, DELETE and
// TRUNCATE (brief §6.3 and §11 `audit_logs`).
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

// Keep in sync with REQUEST_TYPES, REQUEST_STATUSES and PROJECT_STATUSES in src/domain/requests.
enum RequestType {
  BOQ
  RFQ
  PO
}

enum RequestStatus {
  SUBMITTED
  IN_PROGRESS
  // Legacy: no longer offered. Requests that were already waiting keep it until SOA or Purchasing move them on the board.
  WAITING_FOR_SALES
  COMPLETED
  // A completed BOQ that is being revised (BOQ only).
  REVISION
  CANCELLED
}

// Sales' own progress scale and status (their tracking sheet's Progress and Status columns).
// Keep in sync with src/domain/projects/progress.ts.
enum ProjectProgress {
  QUALIFY
  UNDERSTAND
  PROPOSE
  NEGOTIATE
  NEGOTIATE_FU
  AGREE
  CLOSED_WON
  CLOSED_LOST
}

enum TrackStatus {
  ON_TRACK
  ON_HOLD
  DONE
  BLOCK
}

// The part of the BOQ work SOA is on: they label a BOQ request Assessment, Sizing or POC as it moves along.

// Where a project came from. INTERNAL_SALES is the company's own Sales team (the project has a Sales PIC); OTHER is work SOA
// registers that comes from an external sales company or another source (no internal Sales PIC; the external fields describe
// it). Not the project's status and not a request type. Keep in sync with src/domain/projects/source.ts.
enum ProjectSourceType {
  INTERNAL_SALES
  OTHER
}

// Master data. `nameKey` is the trimmed, lower-cased, single-spaced name: it makes "HPE" and "hpe "
// the same record and is what the unique index guards.
model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String   @unique @map("name_key")
  // The customer's industry (Banking, Manufacturing...), filled in on the Customers page. Free text kept tidy by suggesting the existing ones.
  industry  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects Project[]

  @@map("customers")
}

// A brand or vendor whose products a project is built on (HPE, Dell, Hikvision...).
model Principal {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String   @unique @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // `projects` is the legacy first-principal link (Project.principalId); `projectLinks` is the full list a project is built on.
  projects     Project[]
  projectLinks ProjectPrincipal[]

  @@map("principals")
}

// How a distributor is paid. Keep in sync with src/domain/distributors/payment.ts.
enum PaymentType {
  CBD
  COD
  TOP
}

// A distributor Purchasing buys from, kept by Purchasing. `name` is the registered name, `alias` the name people use in daily talk.
// A distributor that an RFQ names is deactivated, not deleted, so the RFQ stays readable. Its payment terms are a list (`terms`, the first is the
// default); the RFQ picks one and keeps a copy.
model Distributor {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String   @unique @map("name_key")
  alias     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  terms    DistributorTerm[]
  requests Request[]

  quotationLines QuotationLine[]
  @@map("distributors")
}

// One way a distributor can be paid. `topDays` is 0 unless the type is TOP (a database check keeps it so). Ordered by `position`; the first is the default.
model DistributorTerm {
  id            String      @id @default(uuid(7)) @db.Uuid
  distributorId String      @map("distributor_id") @db.Uuid
  paymentType   PaymentType @map("payment_type")
  topDays       Int         @default(0) @map("top_days")
  position      Int         @default(0)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([distributorId, paymentType, topDays])
  @@map("distributor_terms")
}

model SolutionCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String   @unique @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects Project[]

  @@map("solution_categories")
}

// The principals (brands) a project is built on: one row per project and principal, so the same principal cannot be linked twice.
// `position` keeps the order they were chosen in; the first one is also written to projects.principal_id.
model ProjectPrincipal {
  projectId   String   @map("project_id") @db.Uuid
  principalId String   @map("principal_id") @db.Uuid
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  principal Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@id([projectId, principalId])
  @@index([principalId])
  @@map("project_principals")
}

// Human-readable codes come from this counter: one row per scope (for example "RFQ-IA-26"
// or "PRJ-26"), incremented atomically inside the creating transaction.
model CodeCounter {
  scope     String @id
  lastValue Int    @map("last_value")

  @@map("code_counters")
}

model Project {
  id             String        @id @default(uuid(7)) @db.Uuid
  // PRJ-001, PRJ-002... (the numbering of the sales export; the counter continues after the highest).
  code           String        @unique
  endUserCompany String        @map("end_user_company")
  name           String
  description    String?
  // Target closing date.
  targetDate     DateTime?     @map("target_date") @db.Date
  // Null only for a project whose source is OTHER (a database check keeps the two in step).
  salesOwnerId   String?       @map("sales_owner_id") @db.Uuid
  // Every project that existed before this column was added is INTERNAL_SALES: each of them has a Sales owner, and no
  // external source was ever recorded, so nothing is inferred.
  sourceType         ProjectSourceType @default(INTERNAL_SALES) @map("source_type")
  externalSourceName String?           @map("external_source_name")
  externalContact    String?           @map("external_contact")
  externalReference  String?           @map("external_reference")
  sourceNotes        String?           @map("source_notes")

  // Commercial fields (Sales-owned; assumption docs/requirements/RBAC.md A-10). Currency is not stored: the
  // sales export holds plain numbers, assumed to be IDR.
  // Sales' Progress (each step stands for a win probability) and Status, and when the quote went out.
  progress          ProjectProgress @default(QUALIFY)
  trackStatus       TrackStatus     @default(ON_TRACK) @map("track_status")
  quoteReleasedAt   DateTime?       @map("quote_released_at") @db.Date
  estimatedValue    Decimal?     @map("estimated_value") @db.Decimal(18, 2)
  probability       Int?
  finalValue        Decimal?     @map("final_value") @db.Decimal(18, 2)
  // Sales' target margin as a percentage of the sale (0 to 100); the margin amount is computed from the value.
  targetMargin      Decimal?     @map("target_margin") @db.Decimal(5, 2)
  // The target margin as a fixed amount (the default way to enter it); when set, it is used instead of the percentage.
  targetMarginValue Decimal?     @map("target_margin_value") @db.Decimal(18, 2)
  wonDate           DateTime?    @map("won_date") @db.Date
  lostReason        String?      @map("lost_reason")
  lostNotes         String?      @map("lost_notes")
  competitor        String?
  competitionStatus String?      @map("competition_status")

  // General information.
  customerId         String? @map("customer_id") @db.Uuid
  // The first of the project's principals (see ProjectPrincipal), kept so lists, filters and exports that read one name keep working.
  principalId        String? @map("principal_id") @db.Uuid
  solutionCategoryId String? @map("solution_category_id") @db.Uuid
  industry           String?
  location           String?
  // Free text from the export: who is involved on the Halcom and customer side.
  stakeholders       String?

  // Technical fields (SOA-owned).
  technicalPicId     String? @map("technical_pic_id") @db.Uuid
  purchasingPicId    String? @map("purchasing_pic_id") @db.Uuid
  // The people behind the two accounts above (see Pic): what the pages show and what a superadmin moves. The accounts stay for notifications.
  soaPicId           String? @map("soa_pic_id") @db.Uuid
  // The part of the BOQ work SOA is on for this project (a key of soa_phases); null until SOA starts.
  phase              String?
  purchasingPicRefId String? @map("purchasing_pic_ref_id") @db.Uuid
  requirement        String?
  assessmentStatus   String? @map("assessment_status")
  solutionProposed   String? @map("solution_proposed")
  architectureStatus String? @map("architecture_status")
  sizingStatus       String? @map("sizing_status")
  boqStatus          String? @map("boq_status")
  quotationStatus    String? @map("quotation_status")
  proposalStatus     String? @map("proposal_status")
  pocStatus          String? @map("poc_status")
  technicalChallenge String? @map("technical_challenge")
  technicalBlocker   String? @map("technical_blocker")
  technicalNotes     String? @map("technical_notes")
  scopeEstimate      String? @map("scope_estimate")

  // Progress notes.
  currentAction String? @map("current_action")
  nextAction    String? @map("next_action")

  customFields Json?   @map("custom_fields")
  // Where an imported project came from (file name); null for projects created in the application.
  importedFrom String? @map("imported_from")

  // Lets a repeated submit of the same form return the first project instead of a duplicate.
  submissionKey String?  @unique @map("submission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Set when a superadmin deletes the project. Every list, chart and export skips it; the rows themselves stay.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  salesOwner       User?             @relation("ProjectSalesOwner", fields: [salesOwnerId], references: [id], onDelete: Restrict)
  technicalPic     User?             @relation("ProjectTechnicalPic", fields: [technicalPicId], references: [id], onDelete: Restrict)
  purchasingPic    User?             @relation("ProjectPurchasingPic", fields: [purchasingPicId], references: [id], onDelete: Restrict)
  soaPic           Pic?              @relation("ProjectSoaPic", fields: [soaPicId], references: [id], onDelete: Restrict)
  phaseOption      SoaPhaseOption?   @relation(fields: [phase], references: [key], onDelete: Restrict)
  purchasingPicRef Pic?              @relation("ProjectPurchasingPicRef", fields: [purchasingPicRefId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  principal        Principal?        @relation(fields: [principalId], references: [id], onDelete: Restrict)
  principals       ProjectPrincipal[]
  solutionCategory SolutionCategory? @relation(fields: [solutionCategoryId], references: [id], onDelete: Restrict)
  deletedBy        User?             @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  requests         Request[]
  changes          ProjectChange[]
  sectionValues    ProjectSectionValue[]
  progressHistory  ProjectProgressHistory[]
  actions          ProjectAction[]

  quotations       Quotation[]
  @@index([progress])
  @@index([salesOwnerId])
  @@index([sourceType])
  @@index([technicalPicId])
  @@index([purchasingPicId])
  @@index([soaPicId])
  @@index([purchasingPicRefId])
  @@index([customerId])
  @@index([principalId])
  @@index([solutionCategoryId])
  @@index([deletedAt])
  @@map("projects")
}

// A unit of work for one team: a BOQ for SOA, or an RFQ / PO for Purchasing.
model Request {
  id              String        @id @default(uuid(7)) @db.Uuid
  // BOQ-IA-260001, RFQ-IA-260001, PO-IA-260001.
  code            String        @unique
  type            RequestType
  projectId       String        @map("project_id") @db.Uuid
  status          RequestStatus @default(SUBMITTED)
  title           String
  description     String        @default("")
  requiredBy      DateTime?     @map("required_by") @db.Date
  requesterId     String        @map("requester_id") @db.Uuid
  // The PIC working on it. Null means "unassigned", which is shown explicitly (brief §6.3).
  picId           String?       @map("pic_id") @db.Uuid
  // The distributor an RFQ is sent to, chosen by Purchasing from the Distributors master; only an RFQ carries one.
  distributorId   String?       @map("distributor_id") @db.Uuid
  // The payment terms chosen for this RFQ out of the distributor's terms, kept as a copy so a later change to the distributor does not rewrite the RFQ.
  paymentType     PaymentType?  @map("payment_type")
  topDays         Int?          @map("top_days")
  // Set on an RFQ or PO that was handed over from a completed BOQ.
  sourceRequestId String?       @map("source_request_id") @db.Uuid
  submissionKey   String?       @unique @map("submission_key")
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  // The SOA PIC who raised it, when SOA raised it (SOA signs in with one shared account, so the person is a PIC). Null for a request
  // raised by Sales or Purchasing, whose account is the person.
  raisedByPicId   String?       @map("raised_by_pic_id") @db.Uuid
  // The file an imported request came from; null for a request raised in the application.
  importedFrom    String?       @map("imported_from")
  // Sales decided not to continue to the next step after this completed BOQ or RFQ (BOQ -> RFQ -> PO).
  flowStoppedAt   DateTime?     @map("flow_stopped_at") @db.Timestamptz(3)
  flowStoppedById String?       @map("flow_stopped_by_id") @db.Uuid
  flowStoppedNote String?       @map("flow_stopped_note")
  // Why a Purchasing request (RFQ or PO) was completed after its SLA deadline; set when it is moved to Completed while overdue.
  overdueNote     String?       @map("overdue_note")
  // Soft delete by a superadmin: the request is hidden everywhere; its history stays (it is append-only). Null while it is live.
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?       @map("deleted_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requester     User                   @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  raisedByPic   Pic?                   @relation("RequestRaisedBy", fields: [raisedByPicId], references: [id], onDelete: Restrict)
  pic           Pic?                   @relation(fields: [picId], references: [id], onDelete: Restrict)
  distributor   Distributor?           @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  picAssignments RequestPicAssignment[]
  flowStoppedBy User?                  @relation("RequestFlowStoppedBy", fields: [flowStoppedById], references: [id], onDelete: Restrict)
  deletedBy     User?                  @relation("RequestDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  source        Request?               @relation("Handover", fields: [sourceRequestId], references: [id], onDelete: Restrict)
  handovers     Request[]              @relation("Handover")
  statusHistory RequestStatusHistory[]

  // A repeated handover click cannot create a second RFQ (or PO) from the same BOQ.
  rfqQuotations Quotation[] @relation("QuotationRfq")
  boqQuotations Quotation[] @relation("QuotationBoq")
  items         RequestItem[]
  @@unique([sourceRequestId, type])
  @@index([projectId])
  @@index([picId])
  @@index([distributorId])
  @@index([raisedByPicId])
  @@index([requesterId])
  @@index([type, status])
  @@index([status])
  @@index([createdAt])
  @@map("requests")
}

// Append-only: the migration installs triggers that reject UPDATE, DELETE and TRUNCATE.
model RequestStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus  @map("to_status")
  changedById String         @map("changed_by_id") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason      String?

  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([requestId, changedAt])
  @@map("request_status_history")
}

// One row per field changed on a project by a person, kept as a log shown on the project page
// ("who changed what, from what, to what, when"). Append-only: the migration installs triggers that
// reject UPDATE, DELETE and TRUNCATE. Values are the text the field held, so history stays readable.
// Every stage a project has been in, newest last (migration 20261028100000). A trigger on projects writes it, so any way of creating or moving a
// project is covered. Append-only. The history starts at the migration (source "baseline"): nothing before it is known, and none is invented.
model ProjectProgressHistory {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  fromProgress ProjectProgress? @map("from_progress")
  toProgress   ProjectProgress  @map("to_progress")
  // Set when the application named the person for the transaction (app.actor_id); otherwise null.
  changedById  String?          @map("changed_by_id") @db.Uuid
  // baseline | insert | update (a database check keeps it to these).
  source       String
  changedAt    DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changedBy User?   @relation("ProgressChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt(sort: Desc)])
  @@map("project_progress_history")
}

model ProjectChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  changedById String   @map("changed_by_id") @db.Uuid
  // A key of PROJECT_EDITABLE_FIELDS (src/domain/projects/fields.ts).
  field       String
  fromValue   String?  @map("from_value")
  toValue     String?  @map("to_value")
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt])
  @@map("project_changes")
}

enum ProjectActionKind {
  CURRENT
  NEXT
}

// A short update on a project, written like a comment: what was done (CURRENT) or what will be done after it
// (NEXT). The feed records when each one was added and by whom; entries are never edited or deleted (the
// migration installs triggers), a correction is a new entry. `projects.current_action` and `next_action` keep the
// text of the latest entry of each kind, written in the same transaction. A null author means the entry came
// from an import.
model ProjectAction {
  id        String            @id @default(uuid(7)) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  kind      ProjectActionKind
  body      String
  authorId  String?           @map("author_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, kind, createdAt])
  @@map("project_actions")
}

// The team an operational PIC works for. Keep in sync with PIC_TEAMS in src/domain/pics/teams.ts.
enum PicTeam {
  SOA
  PURCHASING
}

// An operational assignee of SOA or Purchasing tickets (Adityo, Ibnu...). It is not a login account: SOA and Purchasing each sign in
// with one shared account, and the tickets are handed to PICs. A PIC is deactivated, never deleted, so the assignment history keeps its names.
model Pic {
  id        String   @id @default(uuid(7)) @db.Uuid
  team      PicTeam
  name      String
  // Trimmed, single-spaced, lower-cased name: one team cannot hold the same name twice.
  nameKey   String   @map("name_key")
  // The prefix of request codes raised in this PIC's name (RFQ-A-260001 for Adityo); like a user's, it is kept once given.
  codePrefix String? @unique @map("code_prefix")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests         Request[]
  raisedRequests   Request[]              @relation("RequestRaisedBy")
  assignedTo       RequestPicAssignment[] @relation("AssignmentTo")
  assignedFrom     RequestPicAssignment[] @relation("AssignmentFrom")
  soaProjects      Project[]              @relation("ProjectSoaPic")
  purchasingProjects Project[]            @relation("ProjectPurchasingPicRef")

  quotationApprovals QuotationApproval[] @relation("QuotationApprovalDecidedByPic")
  @@unique([team, nameKey])
  @@index([team, isActive])
  @@map("pics")
}

// Who a request was handed to and by whom, one row per change. Append-only (the migration installs triggers), and a PIC row is never
// deleted, so the history stays readable after a PIC is changed or deactivated.
model RequestPicAssignment {
  id          String   @id @default(uuid(7)) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  fromPicId   String?  @map("from_pic_id") @db.Uuid
  toPicId     String?  @map("to_pic_id") @db.Uuid
  changedById String   @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  request   Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  fromPic   Pic?    @relation("AssignmentFrom", fields: [fromPicId], references: [id], onDelete: Restrict)
  toPic     Pic?    @relation("AssignmentTo", fields: [toPicId], references: [id], onDelete: Restrict)
  changedBy User    @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([requestId, changedAt])
  @@index([toPicId])
  @@map("request_pic_assignments")
}

// How loud a notification is: INFO for news (a request that reached the team), WARNING for an SLA deadline that is near,
// DANGER for an SLA deadline that has passed and for a revision. Keep in sync with src/domain/notifications/severity.ts.
enum NotificationSeverity {
  INFO
  WARNING
  DANGER
}

// Something a person should look at: a request that reached their team, or a project change made by another
// division. Rows are written in the same transaction as the change they describe. SLA alerts are the exception: the
// scheduled scan (src/server/notifications/sla-alerts.ts) writes them when a deadline gets near or passes.
model Notification {
  id          String               @id @default(uuid(7)) @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  // For example "request.created", "request.status_changed", "project.updated", "sla.due_soon".
  kind        String
  severity    NotificationSeverity @default(INFO)
  title       String
  body        String?
  // Where the notification leads, a path inside the application.
  href        String
  // The request an SLA alert is about; null for the rest. No foreign key: an alert may outlive a cleaned-up request.
  requestId   String?              @map("request_id") @db.Uuid
  // "sla:<request id>:<start of the SLA round>:<level>": one alert per recipient, request, round and level. Null for the rest.
  dedupeKey   String?              @map("dedupe_key")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?            @map("read_at") @db.Timestamptz(3)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([requestId])
  @@index([recipientId, severity, readAt])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

// What a receiving team (SOA or Purchasing) is held to and how its emails read: the SLA in working days (1 to 3) and the
// template of the email Sales send it. The superadmin edits it; a team without a row uses the application's defaults.
model TeamSetting {
  role        Role     @id
  // The SLA as a range of days (1 to 7): an answer is expected after slaMinDays and due after slaDays.
  slaMinDays  Int      @map("sla_min_days")
  slaDays     Int      @map("sla_days")
  emailSubject String  @map("email_subject")
  emailBody   String   @map("email_body")
  // Comma-separated addresses; empty falls back to the EMAIL_TO_HIT* / EMAIL_CC_HIT* settings of the server.
  emailTo     String   @default("") @map("email_to")
  emailCc     String   @default("") @map("email_cc")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("TeamSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("team_settings")
}

// A salesperson's own revenue and gross-profit targets for one calendar quarter. A row exists only while at least one of
// the two is set. What was achieved is never stored: it is computed from the projects (src/domain/targets).
model SalesTarget {
  id                String   @id @default(uuid(7)) @db.Uuid
  salesUserId       String   @map("sales_user_id") @db.Uuid
  year              Int
  quarter           Int
  revenueTarget     Decimal? @map("revenue_target") @db.Decimal(18, 2)
  grossProfitTarget Decimal? @map("gross_profit_target") @db.Decimal(18, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesUser User @relation(fields: [salesUserId], references: [id], onDelete: Restrict)

  @@unique([salesUserId, year, quarter])
  @@index([year])
  @@map("sales_targets")
}

// What a superadmin changed in the permission editor: one row per role and permission whose state differs from the defaults in
// src/domain/access/permissions.ts. Permissions themselves stay defined in code (D-013); a role with no row here has the defaults.
// Every change is also written to audit_events with the before and after.
model RolePermissionOverride {
  role        Role
  permission  String
  granted     Boolean
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([role, permission])
  @@map("role_permission_overrides")
}

/** A technical section an Admin or Superadmin added to the project page (the built-in ones are columns of the project). */
model TechnicalSection {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String
  // Trimmed, single-spaced, lower-cased label: two sections cannot share a name.
  labelKey  String   @unique @map("label_key")
  // TEXT: free text. CHOICE: one of `options`.
  kind      String
  options   String[] @default([])
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  values ProjectSectionValue[]

  @@map("technical_sections")
}

model ProjectSectionValue {
  projectId String   @map("project_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  section TechnicalSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@id([projectId, sectionId])
  @@index([sectionId])
  @@map("project_section_values")
}

/** The parts of the BOQ work SOA can be on (Assessment, Sizing, POC and any an Admin or Superadmin added). A project keeps the key. */
model SoaPhaseOption {
  key       String   @id
  label     String
  labelKey  String   @unique @map("label_key")
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  projects Project[]

  @@map("soa_phases")
}

/// The industries a customer can be given; a Superadmin edits the list. The customer keeps the name as text.
model Industry {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String   @unique @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("industries")
}

/// Settings that apply to the whole application, one row per name (for now: which columns the Projects table shows). A Superadmin changes them.
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("app_settings")
}

// ---------------------------------------------------------------------------------------------------------------------------------
// Calculation and quotation (D-088). One row per quotation: the calculation behind it (lines, costs, terms), its approvals, and the
// customer-facing header in the shape of Jurnal's Sales Quote. A project with two options has two rows; at most one is chosen. The rules
// (categories, tax schemes, approval steps, what the quotation shows) are a configuration in app_settings, copied onto a quotation
// when it is submitted.
// ---------------------------------------------------------------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING
  APPROVED
  CANCELLED
}

enum ApprovalState {
  PENDING
  APPROVED
  ACKNOWLEDGED
}

model Quotation {
  id                String          @id @default(uuid(7)) @db.Uuid
  // QUO-26-11-10001, as Jurnal numbers sales quotes: year and month of creation, then one running count (database check on the shape).
  number            String          @unique
  projectId         String          @map("project_id") @db.Uuid
  // The RFQ the buy prices came from ("No. RFQ" on the approval sheet), and the BOQ the lines were filled from.
  rfqRequestId      String?         @map("rfq_request_id") @db.Uuid
  boqRequestId      String?         @map("boq_request_id") @db.Uuid
  // "Opsi 1", "Opsi 2": tells two options of one project apart.
  optionLabel       String          @default("") @map("option_label")
  status            QuotationStatus @default(DRAFT)
  // A tax scheme key of the configuration (NON_WAPU, WAPU...).
  taxScheme         String          @map("tax_scheme")
  preparedById      String          @map("prepared_by_id") @db.Uuid
  // The tax scheme, categories and approval steps the quotation was submitted with; null while it is a draft (a draft follows the
  // current configuration).
  configSnapshot    Json?           @map("config_snapshot")

  // Totals computed by the application at every save (the lines are the truth), kept for lists and dashboards.
  revenue           Decimal         @default(0) @db.Decimal(18, 2)
  grossMargin       Decimal         @default(0) @map("gross_margin") @db.Decimal(18, 2)
  grossMarginBp     Int?            @map("gross_margin_bp")

  // The customer-facing header, in the order of Jurnal's Sales Quote form.
  customerName      String          @map("customer_name")
  email             String?
  billingAddress    String?         @map("billing_address")
  transactionDate   DateTime        @map("transaction_date") @db.Date
  expiryDate        DateTime?       @map("expiry_date") @db.Date
  paymentTerm       String?         @map("payment_term")
  customerReference String?         @map("customer_reference")
  message           String?
  memo              String?

  submittedAt       DateTime?       @map("submitted_at") @db.Timestamptz(3)
  submittedById     String?         @map("submitted_by_id") @db.Uuid
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(3)
  // The last time it was sent back to Sales, and why.
  returnedAt        DateTime?       @map("returned_at") @db.Timestamptz(3)
  returnedById      String?         @map("returned_by_id") @db.Uuid
  returnedReason    String?         @map("returned_reason")
  // The option the customer chose; a partial unique index keeps it to one per project.
  chosenAt          DateTime?       @map("chosen_at") @db.Timestamptz(3)
  chosenById        String?         @map("chosen_by_id") @db.Uuid
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById     String?         @map("cancelled_by_id") @db.Uuid
  cancelReason      String?         @map("cancel_reason")

  // The Sales Quote in Jurnal, once it is sent (not yet built: D-088), and the Sales Order it was converted to.
  jurnalQuoteId     Int?            @unique @map("jurnal_quote_id")
  jurnalSyncedAt    DateTime?       @map("jurnal_synced_at") @db.Timestamptz(3)
  jurnalOrderId     Int?            @unique @map("jurnal_order_id")

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rfqRequest  Request?            @relation("QuotationRfq", fields: [rfqRequestId], references: [id], onDelete: Restrict)
  boqRequest  Request?            @relation("QuotationBoq", fields: [boqRequestId], references: [id], onDelete: Restrict)
  preparedBy  User                @relation("QuotationPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  submittedBy User?               @relation("QuotationSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  returnedBy  User?               @relation("QuotationReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)
  chosenBy    User?               @relation("QuotationChosenBy", fields: [chosenById], references: [id], onDelete: Restrict)
  cancelledBy User?               @relation("QuotationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       QuotationLine[]
  costs       QuotationCost[]
  terms       QuotationTerm[]
  approvals   QuotationApproval[]

  @@index([projectId])
  @@index([status])
  @@index([preparedById])
  @@index([rfqRequestId])
  @@index([boqRequestId])
  @@map("quotations")
}

/** One approval step of one quotation, planned from the configured steps when it is submitted. */
model QuotationApproval {
  id               String        @id @default(uuid(7)) @db.Uuid
  quotationId      String        @map("quotation_id") @db.Uuid
  position         Int
  stepKey          String        @map("step_key")
  label            String
  acknowledgeLabel String        @map("acknowledge_label")
  // Must approve (the condition was met), or is only told and may note it.
  required         Boolean
  status           ApprovalState @default(PENDING)
  // Who approves, as configured when it was submitted: {"kind":"ROLE","role":"PURCHASING"} or {"kind":"USERS","userIds":[...]}.
  approver         Json
  mayEditCosts     Boolean       @default(false) @map("may_edit_costs")
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(3)
  decidedById      String?       @map("decided_by_id") @db.Uuid
  // Purchasing and SOA sign in with one shared account each, so the person who decided can also be a PIC.
  decidedByPicId   String?       @map("decided_by_pic_id") @db.Uuid
  note             String?

  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  decidedBy    User?     @relation("QuotationApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedByPic Pic?      @relation("QuotationApprovalDecidedByPic", fields: [decidedByPicId], references: [id], onDelete: Restrict)

  @@unique([quotationId, position])
  @@unique([quotationId, stepKey])
  @@map("quotation_approvals")
}

/** One revenue row and its cost, on one line as on the sheet ("line item and qty follow the revenue table"). */
model QuotationLine {
  id              String    @id @default(uuid(7)) @db.Uuid
  quotationId     String    @map("quotation_id") @db.Uuid
  position        Int
  // The heading the line sits under ("STORAGE", "JASA"), from the BOQ.
  groupLabel      String?   @map("group_label")
  description     String
  specification   String?
  // A category key of the configuration (GOODS, SERVICES...).
  category        String
  quantity        Decimal   @db.Decimal(12, 3)
  unit            String    @default("Unit")
  sellPrice       Decimal   @map("sell_price") @db.Decimal(18, 2)
  // Null until somebody fills in the buy price; zero is a real price.
  buyPrice        Decimal?  @map("buy_price") @db.Decimal(18, 2)
  // Where the cost side differs from the revenue line ("Kabel, konektor" for a patch cord), else empty.
  costDescription String?   @map("cost_description")
  distributorId   String?   @map("distributor_id") @db.Uuid
  // A vendor that is not in the Distributors master (a marketplace shop), typed as text.
  vendorName      String?   @map("vendor_name")
  vendorTerms     String?   @map("vendor_terms")
  costNote        String?   @map("cost_note")

  quotation   Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)

  @@unique([quotationId, position])
  @@index([distributorId])
  @@map("quotation_lines")
}

model QuotationCost {
  id          String    @id @default(uuid(7)) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  position    Int
  description String
  note        String?
  amount      Decimal   @db.Decimal(18, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, position])
  @@map("quotation_costs")
}

model QuotationTerm {
  id           String    @id @default(uuid(7)) @db.Uuid
  quotationId  String    @map("quotation_id") @db.Uuid
  position     Int
  label        String
  sharePercent Decimal   @map("share_percent") @db.Decimal(5, 2)
  note         String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, position])
  @@map("quotation_terms")
}

/**
 * The items of a BOQ, written by SOA (or imported from the BOQ workbook): what is offered, without prices. A new calculation of the
 * project starts from them, so Sales do not type the unit names, specifications, units and quantities again.
 */
model RequestItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  position      Int
  groupLabel    String?  @map("group_label")
  name          String
  specification String?
  // The category as SOA wrote it ("Network Equipment", "Jasa"); the calculation maps it to a configured category.
  categoryLabel String?  @map("category_label")
  uom           String   @default("Unit")
  quantity      Decimal  @db.Decimal(12, 3)
  note          String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, position])
  @@map("request_items")
}
